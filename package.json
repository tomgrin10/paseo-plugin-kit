{
  "name": "paseo-plugin-kit",
  "version": "0.4.0-beta.0",
  "description": "Tooling shared by Tom's Paseo plugins: release notes, the npm dist-tag guard, a reusable publish workflow, and runtime modules plugins vendor (report an issue).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "paseo-kit": "bin/paseo-kit.mjs"
  },
  "files": [
    "bin/",
    "release/",
    "vendor/",
    "report-issue/",
    "settings-feed-client/",
    "settings-feed-server/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.mjs test/*.test.ts",
    "verify": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "zod": "^4.4.3"
  }
}
